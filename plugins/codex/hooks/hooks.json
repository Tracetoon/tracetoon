{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y tracetoon@1.0.0-rc.51 hook plugin --agent codex --event PreToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y tracetoon@1.0.0-rc.51 hook plugin --agent codex --event SessionStart",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
